# Supabase (Project Settings > API). En local: npx supabase status -o env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca lo expongas al navegador ni lo subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto largo y aleatorio para anonimizar IP/dispositivo: openssl rand -hex 32
HASH_SECRET=

# URL pública del sitio (se usa para identificarse ante el geocodificador)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: otro proveedor de mapas cuando el tráfico crezca
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
